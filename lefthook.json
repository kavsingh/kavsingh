{
	"$schema": "./node_modules/lefthook/schema.json",
	"pre-commit": {
		"jobs": [
			{
				"glob": ["*.{ts,astro,css,html,json,jsonc,yaml,yml}"],
				"run": "bun prettier --no-error-on-unmatched-pattern {staged_files}",
				"stage_fixed": true
			},
			{
				"glob": ["*.{ts,astro}"],
				"run": "bun eslint --fix --no-error-on-unmatched-pattern {staged_files}",
				"stage_fixed": true
			}
		]
	},
	"pre-push": {
		"jobs": [{ "run": "bun run lint" }]
	}
}
